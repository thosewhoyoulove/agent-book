# 仅本机开发使用。开启后，Vite 开发服务器会优先读取 apps/book-web/src/assets/private-audio 中的本机原版音频。
# 生产构建固定使用仓库内 public/online-audio 中的压缩音频，不读取本机路径。
VITE_AGENT_BOOK_LOCAL_MUSIC=false
# 星露谷音乐目录；星露谷环境音目录会按同级 stardew-audio 自动读取。
# AGENT_BOOK_LOCAL_AUDIO_DIR=C:/path/to/project/apps/book-web/src/assets/private-audio/stardew-music
# 蔚蓝和空洞骑士的私有音频目录固定在：
# apps/book-web/src/assets/private-audio/celeste/{music,audio}
# apps/book-web/src/assets/private-audio/hollow/{music,audio}
